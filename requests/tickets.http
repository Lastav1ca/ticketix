@host = http://localhost:3000

### login kao klijent
# @name clientLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{"email":"marko@test.rs","password":"tajnalozinka"}

### lista tiketa (klijent — samo svoje) — 200
GET {{host}}/api/tickets
Authorization: Bearer {{clientLogin.response.body.token}}

### lista bez tokena — 401
GET {{host}}/api/tickets

### login kao agent
# @name agentLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{"email":"agent@test.rs","password":"tajnalozinka"}


### lista tiketa (agent — sve) — 200
GET {{host}}/api/tickets
Authorization: Bearer {{agentLogin.response.body.token}}

### uploaduj tiket - 201
# @name newTicket
POST {{host}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{clientLogin.response.body.token}}

{"title" : "New Ticket", "description" : "Need help with my pc"}


### uploaduj tiket (bez tokena) - 401
POST {{host}}/api/tickets
Content-Type: application/json

{"title" : "New Ticket", "description" : "Need help with my pc"}

### uploaduj prazno telo — 400
POST {{host}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{clientLogin.response.body.token}}

{}

### uploaduj tiket sa status i createdBy — 201, ali ignorisano (status ostaje "open" po defaultu - createdBy je id korisnika)
POST {{host}}/api/tickets
Content-Type: application/json
Authorization: Bearer {{clientLogin.response.body.token}}

{"title":"Hakerski tiket","description":"Probam mass assignment","status":"resolved","createdBy":"00000000-0000-0000-0000-000000000000"}

### agent: open -> in_progress — 200
PATCH {{host}}/api/tickets/{{newTicket.response.body.id}}/status
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.token}}

{"status":"in_progress"}

### klijent menja status — 403
PATCH {{host}}/api/tickets/{{newTicket.response.body.id}}/status
Content-Type: application/json
Authorization: Bearer {{clientLogin.response.body.token}}

{"status":"closed"}

### prelaz u open — 409
PATCH {{host}}/api/tickets/{{newTicket.response.body.id}}/status
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.token}}

{"status":"open"}

### nevalidan status — 400
PATCH {{host}}/api/tickets/{{newTicket.response.body.id}}/status
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.token}}

{"status":"nesto"}

### nevalidan id — 400
PATCH {{host}}/api/tickets/abc/status
Content-Type: application/json
Authorization: Bearer {{agentLogin.response.body.token}}

{"status":"closed"}

### promena statusa bez tokena — 401
PATCH {{host}}/api/tickets/abc/status
Content-Type: application/json

{"status":"closed"}

### bez filtera — 200, {data, page:1, limit:20, total}
GET {{host}}/api/tickets
Authorization: Bearer {{agentLogin.response.body.token}}

### filter po statusu — 200, samo open (seed: 2)
GET {{host}}/api/tickets?status=open
Authorization: Bearer {{agentLogin.response.body.token}}

### filter po prioritetu — 200, samo urgent (seed: 1)
GET {{host}}/api/tickets?priority=urgent
Authorization: Bearer {{agentLogin.response.body.token}}

### kombinacija filtera — 200
GET {{host}}/api/tickets?status=in_progress&priority=urgent
Authorization: Bearer {{agentLogin.response.body.token}}

### paginacija: strana 1, limit 2 — 200, data.length = 2, total = 6
GET {{host}}/api/tickets?page=1&limit=2
Authorization: Bearer {{agentLogin.response.body.token}}

### paginacija: strana 2, limit 2 — 200, drugi tiketi, isti total
GET {{host}}/api/tickets?page=2&limit=2
Authorization: Bearer {{agentLogin.response.body.token}}

### paginacija: strana van opsega — 200, data = []
GET {{host}}/api/tickets?page=99&limit=20
Authorization: Bearer {{agentLogin.response.body.token}}

### klijent vidi samo svoje — 200 (seed: Marko ima 3)
GET {{host}}/api/tickets
Authorization: Bearer {{clientLogin.response.body.token}}

### klijent probava tudji createdBy — 200, ali SAMO SVOJE (filter se ignoriš
GET {{host}}/api/tickets?createdBy=00000000-0000-0000-0000-000000000000
Authorization: Bearer {{clientLogin.response.body.token}}

### nevalidan status — 400
GET {{host}}/api/tickets?status=nesto
Authorization: Bearer {{agentLogin.response.body.token}}

### limit preko granice — 400
GET {{host}}/api/tickets?limit=500
Authorization: Bearer {{agentLogin.response.body.token}}

### page nula — 400
GET {{host}}/api/tickets?page=0
Authorization: Bearer {{agentLogin.response.body.token}}

### limit nije broj — 400
GET {{host}}/api/tickets?limit=abc
Authorization: Bearer {{agentLogin.response.body.token}}

### nevalidan assignedTo uuid — 400
GET {{host}}/api/tickets?assignedTo=abc
Authorization: Bearer {{agentLogin.response.body.token}}

### nepoznat parametar — 200, ignorisan
GET {{host}}/api/tickets?nesto=5
Authorization: Bearer {{agentLogin.response.body.token}}

### bez tokena — 401
GET {{host}}/api/tickets?status=open